# ============================================================
# Ajustador de Siniestros — variables locales (NO se versiona)
# Rellena cada valor a mano y guarda el archivo. Nunca pegues
# estas claves en chats, terminales ni commits.
# ============================================================

# --- Supabase (proyecto exclusivo de cesar) ---
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Referencia del proyecto (para la CLI: supabase link --project-ref ...)
SUPABASE_PROJECT_REF=
# Conexión directa a Postgres (solo para migraciones desde tu equipo)
DATABASE_URL=

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
# Identificador del modelo. Verifica el vigente en la documentación de Gemini.
GEMINI_MODEL=gemini-2.5-pro

# --- Navegador para capturas y PDF ---
# En local usa tu Chrome/Edge. En Vercel se usa @sparticuz/chromium y esto se ignora.
CHROME_PATH=

# --- Aplicación ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Valores de UF: API pública sin clave
UF_API_URL=https://mindicador.cl/api/uf
